{
  "name": "relay-room",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A small, password-protected live message relay for computers on the same network.",
  "scripts": {
    "predev": "node scripts/setup-local.mjs",
    "dev": "node --watch server.js",
    "prestart": "node scripts/setup-local.mjs",
    "start": "node server.js",
    "show-password": "node scripts/show-password.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
